{
  "name": "agendo",
  "version": "1.0.0",
  "description": "Agendo - Gerenciador de Tarefas Inteligente",
  "type": "module",
  "scripts": {
    "predev": "node scripts/kill-ports.cjs",
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run client\"",
    "stop": "node scripts/kill-ports.cjs",
    "server": "node --watch server/index.js",
    "client": "start chrome http://localhost:5173 && vite",
    "start": "node server/index.js",
    "build": "vite build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
