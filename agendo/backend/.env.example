PORT=3001
NODE_ENV=development

# Local (sem URL única)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agendo

# Nuvem (Railway, PlanetScale, Aiven…) — use UMA das opções:
# DATABASE_URL=mysql://usuario:senha@host:3306/agendo
# MYSQL_URL=mysql://usuario:senha@host:3306/agendo

# Cria tabelas e categorias ao iniciar a API (padrão em produção)
AUTO_INIT_DB=true

# URL do frontend na Vercel (CORS)
# FRONTEND_URL=https://seu-app.vercel.app
