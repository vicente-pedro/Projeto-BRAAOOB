PORT=3001
NODE_ENV=development
AUTO_INIT_DB=true

# === MySQL local (com docker compose) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=agendo
DB_NAME=agendo

# === Se você usa MySQL/XAMPP instalado, coloque SUA senha do root: ===
# DB_PASSWORD=sua_senha_aqui

# === Nuvem (Railway) — use em vez das variáveis acima: ===
# DATABASE_URL=mysql://usuario:senha@host:3306/agendo

# URL do frontend na Vercel (CORS)
# FRONTEND_URL=https://seu-app.vercel.app
